// ============================================================================
//  Column names in the model differ from the CSV headers on purpose: the
//  columns a report reader sees are renamed once in the model, so every
//  slicer header, legend and axis title reads in plain English rather than
//  in snake_case. The mapping is:
//
//      dim_country[country]        -> Country
//      dim_band[band_name]         -> Customer size
//      dim_period[period]          -> Half-year
//      dim_year[year]              -> Year
//      dim_component[component_name] -> Component
//
//  Everything else keeps its source name, and the measures below use the
//  renamed columns.
// ============================================================================

// ============================================================================
//  Measures for the Czech industrial energy price report
//  Paste each one separately: Modeling > New measure
// ============================================================================
//
//  Naming: a measure that returns a share ends in %, one that returns money
//  names its unit. Anyone opening the report six months later should be able to
//  read a field list without opening the formulas.
//
//  Put them all in a dedicated "_Measures" table (Home > Enter data, one empty
//  table, then move every measure into it). Measures scattered across fact
//  tables become impossible to find once there are more than a dozen.
//
// ============================================================================
//  1. The base measure. Everything else builds on this one.
// ============================================================================

Avg price (c€/kWh) =
AVERAGE ( fact_prices[price_eur_kwh] ) * 100

// Prices arrive in EUR/kWh. Multiplying by 100 gives euro cents, which is how
// the industry quotes retail prices and how Eurostat's own browser shows them.


// ============================================================================
//  2. Distance to a reference country.
//
//  This is the measure worth understanding properly. A naive version would
//  divide by a hard-coded number and break the moment a slicer moves. This one
//  drops the country filter, re-applies it to the reference row, and compares.
// ============================================================================

Price vs EU average % =
VAR Selected = [Avg price (c€/kWh)]
VAR EUAverage =
    CALCULATE (
        [Avg price (c€/kWh)],
        REMOVEFILTERS ( dim_country ),
        dim_country[role] = "Reference"
    )
RETURN
    DIVIDE ( Selected, EUAverage ) - 1

// REMOVEFILTERS clears whatever the slicer or the row of a visual is filtering
// the country to; the second argument then pins it to the EU row. Every other
// filter in play — band, period, commodity — stays, so the comparison is always
// like for like.
//
// dim_country[role] rather than dim_country[Country] = "EU average": a label can
// change, a role should not.


Price vs Germany % =
VAR Selected = [Avg price (c€/kWh)]
VAR Germany =
    CALCULATE (
        [Avg price (c€/kWh)],
        REMOVEFILTERS ( dim_country ),
        dim_country[Country] = "Germany"
    )
RETURN
    DIVIDE ( Selected, Germany ) - 1


// ============================================================================
//  3. Rank among the neighbouring markets.
//
//  The EU average is an aggregate, not a country, so it must not appear in a
//  ranking of countries. FILTER on the role column keeps it out.
// ============================================================================

Price rank among peers =
IF (
    SELECTEDVALUE ( dim_country[role] ) = "Reference",
    BLANK (),
    RANKX (
        FILTER ( ALL ( dim_country ), dim_country[role] <> "Reference" ),
        [Avg price (c€/kWh)],
        ,
        ASC,
        DENSE
    )
)

// ASC because cheapest = rank 1. DENSE so a tie does not leave a gap.
// The IF returns blank on the EU row instead of a misleading number.


// ============================================================================
//  4. The components of the bill.
//
//  These run against fact_components after it has been unpivoted in Power Query
//  (see power_query.m), so the value column is one column, not three.
// ============================================================================

Component value (c€/kWh) =
SUM ( fact_components[value_eur_kwh] ) * 100


Bill total (c€/kWh) =
CALCULATE (
    [Component value (c€/kWh)],
    REMOVEFILTERS ( dim_component )
)

// The denominator for every share. Dropping the component filter means that
// inside a bar segment — where the filter is "Energy & supply" — this still
// returns the whole bill.


Component share % =
DIVIDE ( [Component value (c€/kWh)], [Bill total (c€/kWh)] )

// Put this in the data label of the stacked bar. Each segment then shows its own
// share of that country's bill rather than a cent figure nobody can compare
// across countries.


Commodity share % =
DIVIDE (
    CALCULATE (
        [Component value (c€/kWh)],
        REMOVEFILTERS ( dim_component ),
        dim_component[set_by] = "Supplier"
    ),
    [Bill total (c€/kWh)]
)

// The headline of the whole report: the share of the bill a supplier can price.
// Filtering on set_by rather than on the component name means that if the data
// ever splits "energy" into two lines, this measure still adds them up.


// ============================================================================
//  5. What a discount is actually worth.
//
//  Needs a What-If parameter first:
//    Modeling > New parameter > Numeric range
//    Name: Discount, Min 0, Max 30, Increment 1, Default 10
//  Power BI creates a table called Discount with a column Discount[Discount].
// ============================================================================

Discount on commodity % =
SELECTEDVALUE ( 'Discount'[Discount], 10 ) / 100

// SELECTEDVALUE's second argument is the fallback when nothing is selected, so
// a card never goes blank because someone cleared the slider.


Bill reduction % =
[Discount on commodity %] * [Commodity share %]

// A 10% cut on a component that is 66% of the bill moves the bill by 6.6%.
// This is the translation rate between what a salesperson offers and what the
// customer sees on the invoice.


Annual saving (EUR) =
VAR VolumeKWh = 2000 * 1000      // a 2 000 MWh/year site, the reference customer
VAR CommodityEurPerKWh =
    CALCULATE (
        SUM ( fact_components[value_eur_kwh] ),
        REMOVEFILTERS ( dim_component ),
        dim_component[set_by] = "Supplier"
    )
RETURN
    [Discount on commodity %] * CommodityEurPerKWh * VolumeKWh

// In euros, because a percentage does not survive a meeting and a euro figure
// does. Swap VolumeKWh for a second What-If parameter to make it adjustable.


// ============================================================================
//  6. Movement over time.
// ============================================================================

Price vs pre-crisis % =
VAR Selected = [Avg price (c€/kWh)]
VAR Baseline =
    CALCULATE (
        [Avg price (c€/kWh)],
        REMOVEFILTERS ( dim_period ),
        dim_period[Half-year] = "2021-S2"
    )
RETURN
    DIVIDE ( Selected, Baseline ) - 1

// 2021-S2 is the last period before the gas crisis. Anything measured against
// 2022 measures the crisis rather than the market.


Latest period =
MAX ( dim_period[Half-year] )

// For a card in the header, so a reader never has to guess which period the
// numbers on the page belong to.
