{
  "name": "Czech energy prices - large type",
  "dataColors": ["#2A78D6", "#1BAF7A", "#EB6834", "#6E4BC4", "#D9A21B", "#0E8C99", "#8F9AA6"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#2A78D6",
  "textClasses": {
    "callout":     { "fontSize": 36, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title":       { "fontSize": 17, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "largeTitle":  { "fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header":      { "fontSize": 15, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label":       { "fontSize": 14, "fontFace": "Segoe UI", "color": "#1F2933" },
    "semiboldLabel": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "largeLabel":  { "fontSize": 16, "fontFace": "Segoe UI", "color": "#1F2933" },
    "smallLabel":  { "fontSize": 13, "fontFace": "Segoe UI", "color": "#43525F" },
    "lightLabel":  { "fontSize": 13, "fontFace": "Segoe UI", "color": "#43525F" },
    "boldLabel":   { "fontSize": 14, "fontFace": "Segoe UI Bold", "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "fontSize": 17, "titleWrap": true, "fontColor": { "solid": { "color": "#1F2933" } } }],
        "categoryAxis": [{ "fontSize": 14, "titleFontSize": 14, "labelColor": { "solid": { "color": "#1F2933" } }, "titleColor": { "solid": { "color": "#43525F" } } }],
        "valueAxis":    [{ "fontSize": 14, "titleFontSize": 14, "labelColor": { "solid": { "color": "#1F2933" } }, "titleColor": { "solid": { "color": "#43525F" } } }],
        "legend":       [{ "fontSize": 14, "labelColor": { "solid": { "color": "#1F2933" } } }],
        "labels":       [{ "fontSize": 13, "color": { "solid": { "color": "#1F2933" } } }],
        "values":       [{ "fontSize": 14, "fontColor": { "solid": { "color": "#1F2933" } } }],
        "columnHeaders":[{ "fontSize": 14 }],
        "border":       [{ "show": true, "color": { "solid": { "color": "#DDE3E8" } }, "radius": 6 }],
        "background":   [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
      },
      "card": {
        "labels":         [{ "fontSize": 34, "color": { "solid": { "color": "#1F2933" } } }],
        "categoryLabels": [{ "fontSize": 14, "color": { "solid": { "color": "#43525F" } } }]
      },
      "slicer": {
        "items":  [{ "fontSize": 14, "fontColor": { "solid": { "color": "#1F2933" } } }],
        "header": [{ "fontSize": 15, "fontColor": { "solid": { "color": "#1F2933" } } }],
        "numericInputStyle": [{ "fontSize": 14 }]
      },
      "page": {
        "background": [{ "color": { "solid": { "color": "#F5F7F9" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#E9EDF1" } }, "transparency": 0 }]
      }
    }
  }
}
